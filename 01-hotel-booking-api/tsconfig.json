{
 "compilerOptions": {
    "module": "esnext",  
    "target": "es2020",                              
    "rootDir": "./src",
    "outDir": "./dist",  
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "ts-node": {
    "esm": true,
    "experimentalEsm": true
  }
}
